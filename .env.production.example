# =============================================================================
# ArtZan — variáveis do deploy na VPS compartilhada (docker-compose.prod.yml)
#
# O script `site` da VPS copia este arquivo para `.env` NA RAIZ do projeto e pede os
# valores que faltam. À mão: `cp .env.production.example .env && chmod 600 .env`.
# O .env tem segredos: está no .gitignore e no .dockerignore e NUNCA deve ser versionado.
# (O `.env.example` da raiz é o de DESENVOLVIMENTO; não confundir.)
#
# O .env é lido duas vezes: pelo compose (interpolação: senha do banco, domínio)
# e pelo container `app` (env_file). Use valores simples, sem aspas e sem `$`.
#
# Variáveis que NÃO aparecem aqui porque o compose as fixa: DATABASE_URI
# (montada a partir de POSTGRES_*), DB_ADAPTER=postgres, NODE_ENV=production,
# SOLICITACOES_DIR=/app/var/solicitacoes. SQLITE_DATABASE_PATH não se aplica.
# =============================================================================

# Faz o `docker compose` usar o arquivo de produção sem precisar de -f.
COMPOSE_FILE=docker-compose.prod.yml

# -----------------------------------------------------------------------------
# DOMÍNIO (o HTTPS e o e-mail do Let's Encrypt ficam no edge, não aqui)
# -----------------------------------------------------------------------------
# Domínio raiz, sem protocolo e sem www. O DNS (registro A, sem AAAA) precisa apontar
# para a VPS ANTES do `site novo`. Usado por deploy/site.caddy.
SITE_DOMAIN=artzan.tech
# Host que redireciona (301) para SITE_DOMAIN. Usado só por deploy/site.caddy.
# Não pode ficar vazio: o script `site` recusa variável de domínio sem valor e o
# bloco `www` do Caddy ficaria sem endereço. Sem www? Remova o bloco de deploy/site.caddy
# e WWW_DOMAIN de DOMAIN_VARS/REQUIRED_VARS em deploy/deploy.conf.
WWW_DOMAIN=www.artzan.tech

# Base absoluta do site, sem barra final. DEVE ser https://<SITE_DOMAIN>.
# É embutida no build (canônico, sitemap, Open Graph, links do e-mail).
NEXT_PUBLIC_SITE_URL=https://artzan.tech

# -----------------------------------------------------------------------------
# MODO DO AMBIENTE
# -----------------------------------------------------------------------------
# homolog  -> marca placeholders, site inteiro não indexável. PADRÃO.
# producao -> o build é RECUSADO se houver registro provisório publicado (7.4).
#             Só mude quando os cinco insumos de 16.6 existirem.
SITE_MODE=homolog

# -----------------------------------------------------------------------------
# BANCO (Postgres 16 no próprio compose, sem porta exposta)
# -----------------------------------------------------------------------------
POSTGRES_USER=artzan
POSTGRES_DB=artzan
# Senha longa e só com [a-f0-9] (entra numa URL de conexão). Vazia, o `site` gera com
# `openssl rand -hex 32`. À mão: openssl rand -hex 32
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# SEGREDO DA APLICAÇÃO (RNF-045, RNF-047, RNF-048)
# -----------------------------------------------------------------------------
# Obrigatório, mínimo 64 caracteres, exclusivo por ambiente (nunca o mesmo em
# homologação e produção). O container recusa subir com valor curto. Vazio, o `site`
# gera com `openssl rand -hex 32` (64 caracteres, o mínimo exigido). À mão:
#   openssl rand -hex 48
PAYLOAD_SECRET=

# -----------------------------------------------------------------------------
# SEED DE HOMOLOGAÇÃO (opcional — só `npm run seed`, nunca automático)
# -----------------------------------------------------------------------------
# Usado apenas pelo comando avulso descrito em deploy/README.md. O seed recusa
# rodar com SITE_MODE=producao. Pode deixar vazio se não for semear.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOME=

# -----------------------------------------------------------------------------
# ENVIO DE E-MAIL (RF-120..132, RNF-092)
# -----------------------------------------------------------------------------
# Sem SMTP, os leads continuam gravados no volume `artzan_solicitacoes`
# (rede de segurança de RNF-092), mas nenhum e-mail sai.
SMTP_HOST=
SMTP_PORT=587
# true para TLS implícito na 465; false para STARTTLS na 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ArtZan

# Caixa compartilhada dos dois sócios, destino de todo lead (PR-021, PR-023).
LEAD_INBOX_ADDRESS=

# -----------------------------------------------------------------------------
# ALERTA DE FALHA DE ENVIO (RNF-092)
# -----------------------------------------------------------------------------
# Endereço DIFERENTE de LEAD_INBOX_ADDRESS.
ALERT_EMAIL_ADDRESS=
ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# CANAL DIRETO E MEDIÇÃO (embutidos no build — mudar exige reiniciar o app)
# -----------------------------------------------------------------------------
# Apenas dígitos com código do país (ex.: 5511999999999). Vazio = canal omitido.
NEXT_PUBLIC_WHATSAPP_NUMERO=
# Vazio = nenhum script de terceiro (D-08 em aberto).
NEXT_PUBLIC_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# AJUSTES DO CONTAINER (opcionais)
# -----------------------------------------------------------------------------
# always (padrão): rebuild a cada subida — é como uma publicação chega ao site.
# if-missing: reaproveita o build em `docker compose restart` (não em recriação).
BUILD_ON_START=always
# Heap do Node durante build e execução. Em VPS de 2 GB, use 1536 e tenha swap.
NODE_OPTIONS=--max-old-space-size=2048
# Espera máxima pelo Postgres e pausa após falha (evita laço de rebuilds).
ESPERA_DB_SEGUNDOS=120
ESPERA_APOS_FALHA_SEGUNDOS=300
