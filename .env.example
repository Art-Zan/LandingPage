# =============================================================================
# ArtZan — site institucional. Modelo de variáveis de ambiente.
#
# COPIE este arquivo para `.env` e preencha com valores REAIS do seu ambiente.
# `.env` está no .gitignore e NUNCA deve ser versionado (RNF-045).
# Este arquivo (.env.example) nunca contém valor real — apenas exemplo e formato.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# String de conexão PostgreSQL usada pelo adaptador do Payload.
# Em desenvolvimento, corresponde ao serviço do docker-compose.yml deste projeto
# (`npm run db:up` sobe o banco; ninguém precisa instalar Postgres na máquina).
DATABASE_URI=postgres://artzan:artzan@localhost:5433/artzan_dev

# -----------------------------------------------------------------------------
# ADAPTADOR DE BANCO — DESENVOLVIMENTO LOCAL SEM DOCKER/POSTGRES (Onda 4c)
# -----------------------------------------------------------------------------
# Postgres continua sendo o adaptador de PRODUÇÃO E HOMOLOGAÇÃO — isso não muda.
# `DB_ADAPTER=sqlite` liga um adaptador SQLite (@payloadcms/db-sqlite, oficial
# do Payload 3) para rodar o projeto nesta máquina sem instalar nada. Ausente
# ou "postgres" = Postgres (padrão). IMPOSSÍVEL usar sqlite quando
# SITE_MODE=producao: `src/payload.config.ts` lança exceção e o processo não
# sobe. A verificação que vale sempre é contra Postgres — diferença de esquema
# entre adaptadores pode mascarar problema real (ver comentário em
# src/payload.config.ts, bloco "ADAPTADOR DE BANCO").
DB_ADAPTER=postgres
# Caminho do arquivo SQLite quando DB_ADAPTER=sqlite (ignorado com postgres).
# Fora do controle de versão (.gitignore). Criado sob demanda pelo adaptador.
SQLITE_DATABASE_PATH=var/dev/artzan-dev.sqlite

# -----------------------------------------------------------------------------
# SEED DE DESENVOLVIMENTO (`npm run seed`, scripts/seed.ts) — Onda 4c
# -----------------------------------------------------------------------------
# Credenciais do usuário administrador de desenvolvimento criado pelo seed.
# Nunca literais no código-fonte (RNF-045): sem estas três variáveis o seed
# recusa criar o usuário e para com erro explicando o que falta.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOME=

# -----------------------------------------------------------------------------
# SEGREDO DA APLICAÇÃO
# -----------------------------------------------------------------------------
# Chave usada pelo Payload para assinar sessão e token do painel (RNF-047, RNF-048).
# Gere um valor aleatório longo, exclusivo por ambiente, e NUNCA reaproveite
# o segredo de produção em homologação. Exemplo de geração:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=troque-por-um-valor-aleatorio-de-no-minimo-64-caracteres

# -----------------------------------------------------------------------------
# ENDEREÇO PÚBLICO
# -----------------------------------------------------------------------------
# Base absoluta do site, sem barra final. Alimenta canônico (RF-161), sitemap
# (RF-163), dados estruturados e os links absolutos do e-mail de confirmação.
# Domínio declarado: artzan.com.br, sujeito a alteração (Q-002).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MODO DO AMBIENTE
# -----------------------------------------------------------------------------
# `homolog`  -> ambiente de homologação (RNF-103). Marca visualmente todo registro
#               placeholder, e o site inteiro é declarado não indexável (RF-164).
# `producao` -> ambiente público. O build FALHA se existir registro marcado como
#               placeholder e publicado ao mesmo tempo. Ver dev/CONVENCOES.md.
# Valores aceitos, exatamente estes dois: homolog | producao
SITE_MODE=homolog

# -----------------------------------------------------------------------------
# ENVIO DE E-MAIL (RF-120..132, RNF-092)
# -----------------------------------------------------------------------------
# Servidor SMTP que envia a confirmação ao visitante e o aviso de novo lead.
# O provedor concreto depende de D-15 (hospedagem), ainda em aberto.
SMTP_HOST=
SMTP_PORT=587
# `true` para conexão TLS implícita na porta 465; `false` para STARTTLS na 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Remetente exibido nas mensagens automáticas. O endereço institucional definitivo
# ainda não existe (item bloqueante de 16.6) — não invente um.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ArtZan

# Caixa compartilhada dos dois sócios, destino de todo lead (PR-021, PR-023).
LEAD_INBOX_ADDRESS=

# -----------------------------------------------------------------------------
# ALERTA DE FALHA DE ENVIO (RNF-092)
# -----------------------------------------------------------------------------
# Corte VETADO por 16.9: o alerta de falha de envio não sai do escopo.
# Se o envio de um lead falhar, alguém precisa saber — este é o destino do aviso.
# Deve ser um endereço DIFERENTE de LEAD_INBOX_ADDRESS: se a caixa de leads for
# justamente o que está falhando, o alerta enviado para ela não chega a ninguém.
ALERT_EMAIL_ADDRESS=
# Opcional e alternativo ao e-mail: webhook que recebe o alerta de falha.
ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# CANAL DIRETO (14.10)
# -----------------------------------------------------------------------------
# Número de WhatsApp comercial, apenas dígitos com código do país (ex.: 5511999999999).
# Vazio no scaffold: o número real é dado de negócio e não é inventado por agente.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# -----------------------------------------------------------------------------
# MEDIÇÃO (D-08, ainda em aberto)
# -----------------------------------------------------------------------------
# Identificador da ferramenta de medição. Deixe vazio enquanto D-08 não for decidida:
# vazio significa "não carregar nenhum script de terceiro" — não um valor padrão.
NEXT_PUBLIC_ANALYTICS_ID=
