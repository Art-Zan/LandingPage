# Dono: onda de deploy (Docker/VPS)
#
# Proxy reverso com TLS automático (Let's Encrypt). O domínio vem de
# SITE_DOMAIN (deploy/.env.production). O Caddy já redireciona http -> https
# sozinho para todo endereço com TLS automático.
#
# HSTS: NÃO é emitido aqui. O Next já envia `Strict-Transport-Security`
# (next.config.ts); duplicar o cabeçalho com valores diferentes é ambíguo.

{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploads do painel (etapa 2) têm teto de 5 MB no Payload; folga para o
	# envelope multipart. O formulário de contato é bem menor.
	request_body {
		max_size 8MB
	}

	header -Server

	reverse_proxy app:3000

	log
}

# Blocos opcionais (ex.: redirecionamento de www). Ver deploy/caddy/sites/.
# Glob sem arquivo correspondente não é erro: o Caddy só registra um aviso.
import /etc/caddy/sites/*.caddy
